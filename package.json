{
  "name": "@local/dsh-plugin-manager",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "插件管理器：侧栏入口，集中查看、按功能分类筛选、启用/停用/卸载，并支持开关快照与一键恢复",
  "license": "MIT",
  "author": "DDTomTom",
  "repository": {
    "type": "git",
    "url": "https://github.com/DDTomTom/dsh-plugin-manager.git"
  },
  "homepage": "https://github.com/DDTomTom/dsh-plugin-manager",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
